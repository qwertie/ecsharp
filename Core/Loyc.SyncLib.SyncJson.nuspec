<?xml version="1.0"?>
<package>
  <metadata>
    <id>Loyc.SyncLib.SyncJson</id>
    <version>$version$</version>
    <authors>David Piepgrass</authors>
    <owners>David Piepgrass</owners>
    <projectUrl>http://core.loyc.net</projectUrl>
    <!--<iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>-->
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>JSON serialization/deserialization support for Loyc.SyncLib.</summary>
    <description>SyncJson provides optimized ISyncManager implementations for reading and writing JSON data with Loyc.SyncLib, a simple, flexible serialization/deserialization framework in which a single "synchronizer" function can both read and write the serialized form of a type.</description>
    <releaseNotes>See http://core.loyc.net/version-history</releaseNotes>
    <copyright>Copyright 2026</copyright>
    <tags>Loyc Core SyncLib JSON Serialization Deserialization</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="readme.md" />

    <file src="Bin\Release\netstandard2.0\Loyc.SyncLib.SyncJson.*" target="lib\netstandard2.0\" />
    <file src="Bin\Release\Loyc.SyncLib.SyncJson.*" target="lib\net472\" />
    <file src="Loyc.SyncLib.SyncJson\**\*.cs" target="src" />
    <file src="Loyc.SyncLib.SyncJson\**\*.ecs" target="src" />
  </files>
</package>
