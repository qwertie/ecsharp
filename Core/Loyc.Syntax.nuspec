<?xml version="1.0"?>
<package>
  <metadata>
    <id>Loyc.Syntax</id>
    <version>$version$</version>
    <authors>David Piepgrass</authors>
    <owners>David Piepgrass</owners>
    <projectUrl>http://core.loyc.net</projectUrl>
    <!--<iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>-->
    <readme>Readme.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>A parser library.</summary>
    <description>Loyc.Syntax implements various interfaces and helper classes for Loyc Languages and for users of LLLPG. It also implements Loyc trees for .NET (LNode), and parsers and printers for Loyc Expression Syntax (LES) versions 2 and 3.</description>
    <releaseNotes>See http://core.loyc.net/version-history</releaseNotes>
    <copyright>Copyright 2020</copyright>
    <tags>Loyc Core Parser LES LLLPG</tags>
    <dependencies>
      <!-- Span/Memory/BinaryPrimitives and Unsafe come from System.Memory on the
           targets that don't have them in-box. netstandard2.1 has Span in-box but
           still needs the package for System.Runtime.CompilerServices.Unsafe. -->
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="5.0.0"/>
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
      </group>
      <!-- net6.0 has System.Memory and Unsafe in-box -->
      <group targetFramework="net6.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="Readme.md" />

    <file src="Bin\Release\netstandard2.0\Loyc.Syntax.*" target="lib\netstandard2.0\" />
    <file src="Bin\Release\netstandard2.1\Loyc.Syntax.*" target="lib\netstandard2.1\" />
    <file src="Bin\Release\net6.0\Loyc.Syntax.*" target="lib\net6.0\" />
    <file src="Bin\Release\Loyc.Syntax.*" target="lib\net472\" />
    <file src="Loyc.Syntax\**\*.cs" target="src" />
    <file src="Loyc.Syntax\**\*.les" target="src" />
    <file src="Loyc.Syntax\**\*.ecs" target="src" />
  </files>
</package>
