<?xml version="1.0"?>
<package>
  <metadata>
    <id>Loyc.Collections</id>
    <version>$version$</version>
    <authors>David Piepgrass</authors>
    <owners>David Piepgrass</owners>
    <projectUrl>http://core.loyc.net</projectUrl>
    <!--<iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>-->
    <readme>Readme.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Defines a number of sophisticated data structures.</summary>
    <description>Loyc.Collections is a library of sophisticated data structures that implement standard .NET collection interfaces. It includes ALists, VLists, hash tree types (Set&lt;T&gt;, MSet&lt;T&gt;, Map&lt;K,V&gt; and MMap&lt;K,V&gt;), and min/max heaps.</description>
    <releaseNotes>See http://core.loyc.net/version-history</releaseNotes>
    <copyright>Copyright 2020</copyright>
    <tags>Loyc Core Collections Extension-Methods Dictionary Trees AList BList DList VList Cache Sparse-List Hash-Trees</tags>
    <dependencies>
      <!-- Span/Memory and Unsafe come from System.Memory on the targets that
           don't have them in-box. netstandard2.1 has Span in-box but still needs
           the package for System.Runtime.CompilerServices.Unsafe. -->
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="5.0.0"/>
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
      </group>
      <!-- net6.0 has System.Memory and Unsafe in-box -->
      <group targetFramework="net6.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="Readme.md" />

    <file src="Bin\Release\netstandard2.0\Loyc.Collections.*" target="lib\netstandard2.0\" />
    <file src="Bin\Release\netstandard2.1\Loyc.Collections.*" target="lib\netstandard2.1\" />
    <file src="Bin\Release\net6.0\Loyc.Collections.*" target="lib\net6.0\" />
    <file src="Bin\Release\Loyc.Collections.*" target="lib\net472\" />
    <file src="Loyc.Collections\**\*.cs" target="src" />
    <file src="Loyc.Collections\**\*.ecs" target="src" />
  </files>
</package>
