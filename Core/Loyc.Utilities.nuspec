<?xml version="1.0"?>
<package>
  <metadata>
    <id>Loyc.Utilities</id>
    <version>$version$</version>
    <authors>David Piepgrass</authors>
    <owners>David Piepgrass</owners>
    <projectUrl>http://core.loyc.net</projectUrl>
    <!--<iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>-->
    <readme>Readme.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Additional functionality to extend the Loyc core libraries.</summary>
    <description>Loyc.Utilities contains useful non-core functionality that is either (A) not important enough to be placed in Loyc.Essentials or (B) takes Loyc.Collections, Loyc.Math or Loyc.Syntax as a dependency.</description>
    <releaseNotes>See http://core.loyc.net/version-history</releaseNotes>
    <copyright>Copyright 2020</copyright>
    <tags>Loyc Core Utilities Adapters Interfaces</tags>
    <dependencies>
      <!-- System.Reflection.Emit (used by GoInterface) is in-box on .NET Framework
           and .NET 6, but is not part of netstandard2.0/2.1. -->
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="Loyc.Math" version="$version$"/>
        <dependency id="Loyc.Syntax" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="5.0.0"/>
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="Loyc.Math" version="$version$"/>
        <dependency id="Loyc.Syntax" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
        <dependency id="System.Reflection.Emit" version="4.7.0"/>
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="Loyc.Math" version="$version$"/>
        <dependency id="Loyc.Syntax" version="$version$"/>
        <dependency id="System.Memory" version="4.5.4"/>
        <dependency id="System.Reflection.Emit" version="4.7.0"/>
      </group>
      <!-- net6.0 has System.Memory, Unsafe and Reflection.Emit in-box -->
      <group targetFramework="net6.0">
        <dependency id="Loyc.Interfaces" version="$version$"/>
        <dependency id="Loyc.Essentials" version="$version$"/>
        <dependency id="Loyc.Collections" version="$version$"/>
        <dependency id="Loyc.Math" version="$version$"/>
        <dependency id="Loyc.Syntax" version="$version$"/>
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="Readme.md" />

    <file src="Bin\Release\netstandard2.0\Loyc.Utilities.*" target="lib\netstandard2.0\" />
    <file src="Bin\Release\netstandard2.1\Loyc.Utilities.*" target="lib\netstandard2.1\" />
    <file src="Bin\Release\net6.0\Loyc.Utilities.*" target="lib\net6.0\" />
    <file src="Bin\Release\Loyc.Utilities.*" target="lib\net472\" />
    <file src="Loyc.Utilities\**\*.cs" target="src" />
    <file src="Loyc.Utilities\**\*.ecs" target="src" />
  </files>
</package>
